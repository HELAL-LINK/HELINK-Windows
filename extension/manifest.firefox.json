{
  "manifest_version": 2,
  "name": "__MSG_extName__",
  "short_name": "HELINK",
  "description": "__MSG_extDesc__",
  "version": "@VERSION@",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "helink@helaltech.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "browser_action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "scripts": ["strings.js", "background.js"], "persistent": true },
  "permissions": ["downloads", "nativeMessaging", "cookies", "storage", "contextMenus", "webRequest", "tabs", "<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ]
}
