{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "HELINK",
  "description": "__MSG_extDesc__",
  "version": "@VERSION@",
  "default_locale": "en",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "permissions": ["downloads", "downloads.ui", "nativeMessaging", "cookies", "storage", "contextMenus", "webRequest", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ]
}
